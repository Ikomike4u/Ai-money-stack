<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Payment Confirmed — Get Your AI Money Stack PDF</title>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet"/>
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    background: #080810;
    color: #fff;
    font-family: 'DM Sans', sans-serif;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 40px 20px;
    overflow-x: hidden;
  }

  /* animated background */
  body::before {
    content: '';
    position: fixed; inset: 0;
    background:
      radial-gradient(ellipse 60% 50% at 50% 0%, rgba(37,211,102,.12) 0%, transparent 70%),
      radial-gradient(ellipse 40% 40% at 80% 80%, rgba(245,166,35,.08) 0%, transparent 60%);
    pointer-events: none;
  }

  .card {
    background: #12121f;
    border: 1px solid rgba(37,211,102,.25);
    border-radius: 20px;
    max-width: 520px;
    width: 100%;
    padding: 52px 40px;
    text-align: center;
    position: relative;
    box-shadow: 0 0 80px rgba(37,211,102,.1);
    animation: popIn .6s cubic-bezier(.34,1.56,.64,1) both;
  }

  @keyframes popIn {
    from { opacity: 0; transform: scale(.9) translateY(20px); }
    to   { opacity: 1; transform: scale(1) translateY(0); }
  }

  /* green top bar */
  .card::before {
    content: '';
    position: absolute; top: 0; left: 0; right: 0; height: 4px;
    background: linear-gradient(90deg, #25D366, #F5A623, #25D366);
    background-size: 200%;
    border-radius: 20px 20px 0 0;
    animation: shimmer 3s linear infinite;
  }
  @keyframes shimmer { to { background-position: 200% center; } }

  .check-circle {
    width: 80px; height: 80px;
    background: rgba(37,211,102,.15);
    border: 2px solid #25D366;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    margin: 0 auto 28px;
    animation: pulse 2s ease-in-out infinite;
  }
  @keyframes pulse {
    0%,100% { box-shadow: 0 0 0 0 rgba(37,211,102,.4); }
    50%      { box-shadow: 0 0 0 16px rgba(37,211,102,0); }
  }
  .check-circle svg { width: 40px; height: 40px; }

  .tag {
    display: inline-block;
    background: rgba(37,211,102,.12);
    border: 1px solid rgba(37,211,102,.3);
    color: #25D366;
    font-family: 'Syne', sans-serif;
    font-size: 11px; font-weight: 700;
    letter-spacing: 3px; text-transform: uppercase;
    padding: 5px 16px; border-radius: 20px;
    margin-bottom: 20px;
  }

  h1 {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 42px; line-height: 1;
    letter-spacing: 1px;
    margin-bottom: 16px;
  }
  h1 span { color: #F5A623; }

  .subtitle {
    font-size: 16px; color: #a0a0b8;
    line-height: 1.6; margin-bottom: 36px;
  }
  .subtitle strong { color: #fff; }

  /* Steps */
  .steps {
    background: #0f0f1a;
    border: 1px solid rgba(255,255,255,.06);
    border-radius: 12px;
    padding: 24px 24px 16px;
    margin-bottom: 32px;
    text-align: left;
  }
  .steps-title {
    font-family: 'Syne', sans-serif;
    font-size: 12px; font-weight: 700;
    letter-spacing: 2px; text-transform: uppercase;
    color: #F5A623; margin-bottom: 16px;
  }
  .step-row {
    display: flex; align-items: flex-start; gap: 14px;
    margin-bottom: 14px;
  }
  .step-num {
    width: 28px; height: 28px; flex-shrink: 0;
    background: rgba(245,166,35,.15);
    border: 1px solid rgba(245,166,35,.3);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-family: 'Syne', sans-serif;
    font-size: 12px; font-weight: 800; color: #F5A623;
  }
  .step-text { font-size: 14px; color: #a0a0b8; line-height: 1.5; padding-top: 4px; }
  .step-text strong { color: #fff; }

  /* WhatsApp button */
  .wa-btn {
    display: flex; align-items: center; justify-content: center; gap: 10px;
    background: #25D366;
    color: #000;
    font-family: 'Syne', sans-serif;
    font-weight: 800; font-size: 17px;
    padding: 18px 24px; border-radius: 8px;
    text-decoration: none; width: 100%;
    letter-spacing: .3px;
    box-shadow: 0 0 40px rgba(37,211,102,.3);
    transition: transform .25s, box-shadow .25s;
    position: relative; overflow: hidden;
    margin-bottom: 14px;
  }
  .wa-btn::before {
    content: '';
    position: absolute; inset: 0;
    background: linear-gradient(120deg, transparent 30%, rgba(255,255,255,.25) 50%, transparent 70%);
    transform: translateX(-100%);
    transition: transform .5s;
  }
  .wa-btn:hover::before { transform: translateX(100%); }
  .wa-btn:hover { transform: translateY(-3px); box-shadow: 0 8px 50px rgba(37,211,102,.45); }

  .wa-note {
    font-size: 12px; color: #666;
    margin-bottom: 28px;
  }

  /* countdown */
  .countdown-wrap {
    background: rgba(245,166,35,.06);
    border: 1px solid rgba(245,166,35,.15);
    border-radius: 8px; padding: 14px 20px;
    margin-bottom: 28px;
  }
  .countdown-label {
    font-size: 12px; color: #a0a0b8; margin-bottom: 4px;
  }
  #countdown {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 32px; color: #F5A623; letter-spacing: 2px;
  }

  .divider {
    border: none; border-top: 1px solid rgba(255,255,255,.06);
    margin: 24px 0;
  }

  .footer-note {
    font-size: 12px; color: #555; line-height: 1.7;
  }
  .footer-note a { color: #F5A623; text-decoration: none; }

  @media (max-width: 500px) {
    .card { padding: 36px 24px; }
    h1 { font-size: 34px; }
  }
</style>
</head>
<body>

<div class="card">

  <!-- Check icon -->
  <div class="check-circle">
    <svg viewBox="0 0 24 24" fill="none" stroke="#25D366" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="20 6 9 17 4 12"></polyline>
    </svg>
  </div>

  <div class="tag">✅ Payment Confirmed</div>

  <h1>YOU'RE IN!<br/>GET YOUR <span>PDF NOW</span></h1>

  <p class="subtitle">
    Your payment was successful. <strong>You are one WhatsApp message away</strong> from receiving your AI Money Stack PDF.
  </p>

  <!-- How to get your PDF -->
  <div class="steps">
    <div class="steps-title">📋 3 Simple Steps to Get Your PDF</div>

    <div class="step-row">
      <div class="step-num">1</div>
      <div class="step-text"><strong>Take a screenshot</strong> of your payment confirmation or copy your transaction ID.</div>
    </div>

    <div class="step-row">
      <div class="step-num">2</div>
      <div class="step-text"><strong>Click the WhatsApp button below</strong> — it opens a direct chat with us instantly.</div>
    </div>

    <div class="step-row">
      <div class="step-num">3</div>
      <div class="step-text"><strong>Send your receipt</strong> and we will deliver your PDF straight to your WhatsApp DM — usually within minutes.</div>
    </div>
  </div>

  <!-- Auto redirect countdown -->
  <div class="countdown-wrap">
    <div class="countdown-label">Redirecting you to WhatsApp in</div>
    <div id="countdown">10</div>
  </div>

  <!-- WhatsApp CTA -->
  <a href="https://wa.me/2348067754123?text=Hello%2C%20I%20just%20made%20payment%20for%20the%20AI%20Money%20Stack.%20Please%20find%20my%20receipt%20attached.%20Kindly%20send%20my%20PDF.%20Thank%20you!"
     class="wa-btn" target="_blank" id="waBtn">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
    </svg>
    Chat on WhatsApp — Get My PDF
  </a>

  <p class="wa-note">Opens WhatsApp with a pre-written message ready to send 👆</p>

  <hr class="divider"/>

  <p class="footer-note">
    Having trouble? Message us directly at <a href="https://wa.me/2348067754123" target="_blank">+234 806 775 4123</a><br/>
    We respond within minutes during business hours.
  </p>

</div>

<script>
  // Auto-countdown and redirect to WhatsApp
  let seconds = 10;
  const countdownEl = document.getElementById('countdown');
  const waUrl = "https://wa.me/2348067754123?text=Hello%2C%20I%20just%20made%20payment%20for%20the%20AI%20Money%20Stack.%20Please%20find%20my%20receipt%20attached.%20Kindly%20send%20my%20PDF.%20Thank%20you!";

  const timer = setInterval(() => {
    seconds--;
    countdownEl.textContent = seconds;
    if (seconds <= 0) {
      clearInterval(timer);
      window.location.href = waUrl;
    }
  }, 1000);

  // If user clicks button, stop countdown
  document.getElementById('waBtn').addEventListener('click', () => {
    clearInterval(timer);
    countdownEl.textContent = '✓';
  });
</script>

</body>
</html>
